        <mxCell id="n12" parent="1" style="shape=image;imageAspect=0;image=data:image/png,;strokeColor=light-dark(#000000,#FFFF99);strokeWidth=3.0;fillColor=light-dark(#FFFFFF,#CCFF99);imageBorder=light-dark(transparent,#FFFF99);" value="" vertex="1">
